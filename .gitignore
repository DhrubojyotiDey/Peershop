# ── Secrets / credentials ──
.env
*.env
.env.*
secrets.py
*_secret*
*_key*
api_keys*
credentials*

# ── Runtime data — NEVER versioned (contains PII) ──
*.db
*.db.bak*
peershop.db*

# ── Logs / pids / runtime state ──
*.log
*.pid
bot_offset

# ── Uploaded & seed media (binaries; per-environment) ──
media/

# ── Heavy deps (venv) & bytecode ──
.venv/
__pycache__/
*.pyc
*.pyo

# ── Large screenshot artifacts ──
*.png.png
Screenshot_*.png

# ── Local harness/IDE settings ──
.claude/
.idea/
.vscode/

# ── Backup databases ──
*.bak
*.bak.*
